<?xml version="1.0"?>
<package format="3">
  <name>ir_signal_action</name>
  <version>0.0.1</version>
  <description>Action server to trigger an IR carrier burst for the mini fridge.</description>
  <maintainer email="trace@example.com">trace</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>action_msgs</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Python dependency `rpi-hardware-pwm` is installed via pip in Docker -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
